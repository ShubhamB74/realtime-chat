# Template. `make env` copies this to .env and replaces CHANGE_ME_* with random values.
# .env is git-ignored. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text
HTTP_ADDR=:8080

# Used by docker compose (service containers)
POSTGRES_USER=chat
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=realtime_chat
REDIS_PASSWORD=CHANGE_ME_REDIS

# Used by host-run tools: `make run`, `make migrate-*`, `make test-integration`
DATABASE_URL=postgres://chat:CHANGE_ME_POSTGRES@localhost:5432/realtime_chat?sslmode=disable
REDIS_URL=redis://:CHANGE_ME_REDIS@localhost:6379/0
# Optional dependencies (reported by /readyz, never required)
KAFKA_BROKERS=localhost:29092
OBJECT_STORE_ADDR=localhost:8333
